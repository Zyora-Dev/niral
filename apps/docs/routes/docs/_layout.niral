<server>
export async function load({ params }) {
  const { GROUPS, PAGES } = await projectImport("lib/content.js")
  return {
    current: params.slug ?? "",
    nav: GROUPS.map((g) => ({ name: g.name, items: g.slugs.map((s) => ({ slug: s, title: PAGES[s].title })) })),
  }
}

// full-text search over every doc page — title > heading > body, with a snippet
export async function searchDocs(q) {
  const query = String(q ?? "").trim().toLowerCase()
  if (query.length < 2) return []
  const { PAGES } = await projectImport("lib/content.js")
  const { plainText } = await projectImport("lib/md.js")
  const hits = []
  for (const [slug, page] of Object.entries(PAGES)) {
    const title = page.title.toLowerCase()
    const headings = [...page.body.matchAll(/^#{1,4}\s+(.*)$/gm)].map((m) => m[1])
    const text = plainText(page.body)
    const lower = text.toLowerCase()
    let score = 0
    if (title.includes(query)) score += 100
    const heading = headings.find((h) => h.toLowerCase().includes(query))
    if (heading) score += 40
    const at = lower.indexOf(query)
    if (at !== -1) score += 10
    if (!score) continue
    const from = Math.max(0, at === -1 ? 0 : at - 40)
    const snippet = (from > 0 ? "…" : "") + text.slice(from, from + 110).trim() + "…"
    hits.push({ slug, title: page.title, heading: heading ?? null, snippet, score })
  }
  return hits.sort((a, b) => b.score - a.score).slice(0, 8)
}
</server>

<script>
  let { nav, current } = $props
  let q = $state("")
  let results = $state([])
  let searching = $state(false)
  let sidebarOpen = $state(false)
  let timer = null
  let searchVersion = 0

  function onSearch(value) {
    q = value
    const version = ++searchVersion
    clearTimeout(timer)
    if (value.trim().length < 2) { results = []; searching = false; return }
    searching = true
    timer = setTimeout(async () => {
      try {
        const hits = await searchDocs(value)
        if (version === searchVersion) results = hits
      } catch { if (version === searchVersion) results = [] }
      if (version === searchVersion) searching = false
    }, 150)
  }
  function clearSearch() { searchVersion++; clearTimeout(timer); q = ""; results = []; searching = false; sidebarOpen = false }
</script>

<div class={sidebarOpen ? "wrap nav-open" : "wrap"}>
  <a class="skip-link" href="#doc-content">Skip to content</a>
  <header class="topbar" on:keydown={(e) => { if (e.key === "Escape") { clearSearch(); sidebarOpen = false } }}>
    <button class="hamburger" on:click={() => (sidebarOpen = !sidebarOpen)} aria-label={sidebarOpen ? "Close navigation" : "Open navigation"} aria-expanded={sidebarOpen ? "true" : "false"} aria-controls="docs-navigation" title="Toggle navigation">
      <span></span><span></span><span></span>
    </button>
    <a class="brand" href="/">
      <img class="brand-logo" src="/niral-logo.png" alt="Niral" />
      <span class="docs-tag">Docs</span>
    </a>
    <div class="search">
      <span class="search-icon" aria-hidden="true"></span>
      <input type="search" aria-label="Search documentation" aria-controls="doc-search-results" bind:value={q} on:input={(e) => onSearch(e.target.value)} placeholder="Search documentation…" />
      {#if q.trim().length >= 2}
        <div class="results" id="doc-search-results" aria-live="polite" transition:fade>
          {#if searching}
            <p class="hint">searching…</p>
          {:else if results.length === 0}
            <p class="hint">no matches for “{q}”</p>
          {:else}
            {#for r of results key r.slug}
              <a class="result" href={"/docs/" + r.slug} on:click={clearSearch}>
                <b>{r.title}</b>{#if r.heading}<span class="sec"> › {r.heading}</span>{/if}
                <span class="snippet">{r.snippet}</span>
              </a>
            {/for}
          {/if}
        </div>
      {/if}
    </div>
    <nav class="toplinks" aria-label="Resources">
      <a href="/changelog">Changelog <span aria-hidden="true">↗</span></a>
      <a href="/">Website <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <button class="scrim" on:click={() => (sidebarOpen = false)} aria-label="Close navigation" tabindex="-1"></button>
  <aside class="sidebar" id="docs-navigation" on:keydown={(e) => { if (e.key === "Escape") sidebarOpen = false }}>
    <div class="sidebar-heading">
      <svg class="book-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 7v14" />
        <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
      </svg>
      Documentation
    </div>
    <nav aria-label="Documentation">
      {#for g of nav key g.name}
        <section class="nav-group" aria-label={g.name}>
          <h2 class="group">{g.name}</h2>
          <div class="nav-items">
            {#for item of g.items key item.slug}
              <a class={item.slug === current ? "navlink active" : "navlink"} aria-current={item.slug === current ? "page" : undefined} href={"/docs/" + item.slug} on:click={() => (sidebarOpen = false)}>{item.title}</a>
            {/for}
          </div>
        </section>
      {/for}
    </nav>

    <div class="aside-foot">
      <a href="/">← home</a>
      <a href="/changelog">changelog</a>
    </div>
  </aside>

  <main class="content" id="doc-content" tabindex="-1">
    <slot />
  </main>
</div>

<style>
  :global(body) { margin: 0; background: #080809; color: #fafafa; }
  :global(::selection) { background: #f2b544; color: #080809; }
  .wrap { --surface: #18181b; --surface-raised: #232326; --line: #363639; --line-strong: #505054; --text: #fafafa; --accent: #f2b544; --accent-hover: #ffd17b; --accent-soft: #f2b54414; display: grid; grid-template-columns: 244px minmax(0, 1fr); max-width: 1520px; margin: auto; min-height: 100vh; font-family: "Geist", sans-serif; letter-spacing: 0; }
  .wrap :global(*) { box-sizing: border-box; }
  .wrap :global(button), .wrap :global(input), .wrap :global(select) { font-family: "Geist", sans-serif; }
  .wrap :global(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  .skip-link { position: fixed; top: -80px; left: 24px; z-index: 100; padding: 12px 20px; background: var(--accent); color: #080809; border-radius: 6px; }
  .skip-link:focus { top: 12px; }
  .topbar { grid-column: 1 / -1; display: grid; grid-template-columns: 220px minmax(200px, 560px) 1fr; align-items: center; gap: 24px; position: sticky; top: 0; z-index: 70; height: 80px; padding: 0 32px; border-bottom: 1px solid var(--line); background: #0b0b0df5; backdrop-filter: blur(16px); }
  .brand { display: flex; align-items: center; gap: 16px; text-decoration: none; width: fit-content; }
  .brand-logo { display: block; height: 28px; width: auto; }
  .docs-tag { color: var(--text); border-left: 1px solid var(--line-strong); padding-left: 16px; font-size: 14px; }
  .toplinks { display: flex; justify-content: flex-end; gap: 24px; white-space: nowrap; }
  .toplinks a { color: var(--text); font-size: 13px; text-decoration: none; }
  .toplinks span { color: var(--accent); margin-left: 4px; }
  .toplinks a:hover { color: var(--accent); }
  .search { position: relative; min-width: 0; }
  .search input { width: 100%; height: 44px; background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: 8px; padding: 0 16px 0 44px; color: var(--text); font: 14px "Geist", sans-serif; transition: border-color .15s; }
  .search input:focus { border-color: var(--accent); outline: none; }
  .search input::placeholder { color: #bcbcc2; }
  .search-icon { position: absolute; left: 17px; top: 14px; width: 13px; height: 13px; border: 1.6px solid var(--text); border-radius: 50%; pointer-events: none; }
  .search-icon::after { content: ""; position: absolute; width: 6px; height: 1.6px; background: var(--text); bottom: -3px; right: -4px; transform: rotate(45deg); }
  .results { position: absolute; top: calc(100% + 12px); left: 0; right: 0; z-index: 80; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; box-shadow: 0 20px 60px #0008; overflow: auto; max-height: min(560px, 65dvh); }
  .hint { color: var(--text); font-size: 14px; padding: 20px; margin: 0; }
  .result { display: block; padding: 18px 20px; text-decoration: none; border-bottom: 1px solid var(--line); }
  .result:last-child { border-bottom: 0; }
  .result:hover, .result:focus-visible { background: var(--surface-raised); }
  .result b { color: var(--text); font-size: 14px; font-weight: 600; }
  .result .sec { color: var(--accent); font-size: 13px; }
  .result .snippet { display: block; color: var(--text); font-size: 13px; margin-top: 8px; line-height: 1.65; overflow-wrap: anywhere; }
  .sidebar { display: flex; flex-direction: column; border-right: 1px solid var(--line); padding: 24px 16px; position: sticky; top: 80px; align-self: start; height: calc(100dvh - 80px); overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; background: linear-gradient(160deg, #171719, #0b0b0c); }
  .sidebar nav { display: flex; flex-direction: column; gap: 20px; }
  .sidebar-heading { display: flex; gap: 10px; align-items: center; padding: 0 12px 20px; margin-bottom: 20px; border-bottom: 1px solid var(--line); font-size: 14px; line-height: 20px; font-weight: 600; }
  .book-icon { display: block; width: 20px; height: 20px; flex: none; color: var(--text); }
  .nav-group { margin: 0; padding: 0; }
  .group { display: flex; align-items: center; gap: 10px; color: var(--text); font-size: 12px; line-height: 18px; font-weight: 700; text-transform: uppercase; margin: 0 12px 8px; padding: 0; }
  .group::after { content: ""; flex: 1; height: 1px; background: var(--line-strong); }
  .nav-items { display: grid; gap: 2px; }
  .navlink { display: flex; align-items: center; color: var(--text); text-decoration: none; min-height: 36px; padding: 8px 12px; margin: 0; border: 0; border-radius: 6px; font-size: 13px; line-height: 20px; transition: background .15s, color .15s; }
  .navlink:hover { background: var(--surface-raised); color: #fff; }
  .navlink.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; box-shadow: inset 2px 0 var(--accent); }
  .aside-foot { display: flex; justify-content: space-between; gap: 12px; margin: 24px 12px 0; padding-top: 20px; border-top: 1px solid var(--line); font-size: 12px; }
  .aside-foot a { color: var(--text); text-decoration: none; }
  .aside-foot a:hover { color: var(--accent); }
  .content { padding: 48px 48px 80px; min-width: 0; background: linear-gradient(135deg, #232326 0, #101012 600px, #080809 1400px); }
  .hamburger, .scrim { display: none; }
  @media (max-width: 1200px) {
    .topbar { grid-template-columns: 188px minmax(180px, 1fr) auto; gap: 24px; padding: 0 24px; }
    .toplinks { gap: 16px; }
    .wrap { grid-template-columns: 224px minmax(0, 1fr); }
    .content { padding: 40px 32px 64px; }
    .sidebar { padding-right: 14px; padding-left: 14px; }
  }
  @media (max-width: 860px) {
    .wrap { grid-template-columns: minmax(0, 1fr); }
    .topbar { height: 132px; grid-template-columns: 40px 1fr auto; gap: 12px; padding: 16px 20px; }
    .brand { gap: 12px; }
    .brand-logo { height: 24px; }
    .docs-tag { padding-left: 12px; }
    .search { grid-row: 2; grid-column: 1 / -1; }
    .toplinks a:last-child { display: none; }
    .hamburger { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; width: 40px; height: 40px; padding: 10px; background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: 6px; cursor: pointer; }
    .hamburger span { display: block; height: 2px; width: 18px; background: var(--text); }
    .sidebar { position: fixed; top: 132px; left: 0; bottom: 0; width: 292px; max-width: 85vw; height: calc(100dvh - 132px); z-index: 60; padding: 24px 20px; transform: translateX(-100%); visibility: hidden; transition: transform .2s, visibility .2s; }
    .nav-open .sidebar { transform: translateX(0); visibility: visible; }
    .nav-open .scrim { display: block; position: fixed; inset: 132px 0 0; z-index: 50; background: #0009; border: 0; padding: 0; width: 100%; }
    .content { padding: 32px 24px 48px; }
  }
  @media (max-width: 380px) { .topbar { padding-left: 16px; padding-right: 16px; } .toplinks { display: none; } .content { padding-left: 20px; padding-right: 20px; } }
  @media (prefers-reduced-motion: reduce) { .sidebar, .navlink, .search input { transition: none; } }
</style>
