<script mode="static">
  const demo = "&lt;server&gt;\n<span class='k'>export async function</span> <span class='f'>load</span>() {\n  <span class='k'>return</span> { items: <span class='k'>await</span> db.all() }          <span class='c'>// SSR data — never ships</span>\n}\n<span class='k'>export async function</span> <span class='f'>add</span>(text) {\n  <span class='f'>publish</span>(\"todos\", { text })                <span class='c'>// realtime to every tab</span>\n}\n&lt;/server&gt;\n\n&lt;script&gt;\n  <span class='k'>let</span> { items } = <span class='r'>$props</span>\n  <span class='k'>let</span> list = <span class='r'>$state</span>(items)\n  <span class='f'>live</span>(\"todos\", (t) =&gt; list = [...list, t])\n&lt;/script&gt;\n\n{#for t of list key t.id}\n  &lt;li transition:fade&gt;{t.text}&lt;/li&gt;\n{/for}"
</script>

<head>
  <title>நிரல் · Niral — the zero-dependency full-stack framework</title>
  <meta name="description" content="Niral: compiler-first full-stack web framework. Svelte-class performance, Rails-class features, zero dependencies. By ZyoraLabs." />
</head>

<main>
  <nav class="nav">
    <a class="mark" href="/"><span class="mark-glyph">நி</span><span class="mark-name">niral</span></a>
