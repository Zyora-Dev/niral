<script mode="static">
  const demo = "&lt;server&gt;\n<span class='k'>export async function</span> <span class='f'>load</span>() {\n  <span class='k'>return</span> { items: <span class='k'>await</span> db.all() }          <span class='c'>// SSR data — never ships</span>\n}\n<span class='k'>export async function</span> <span class='f'>add</span>(text) {\n  <span class='f'>publish</span>(\"todos\", { text })                <span class='c'>// realtime to every tab</span>\n}\n&lt;/server&gt;\n\n&lt;script&gt;\n  <span class='k'>let</span> { items } = <span class='r'>$props</span>\n  <span class='k'>let</span> list = <span class='r'>$state</span>(items)\n  <span class='f'>live</span>(\"todos\", (t) =&gt; list = [...list, t])\n&lt;/script&gt;\n\n{#for t of list key t.id}\n  &lt;li transition:fade&gt;{t.text}&lt;/li&gt;\n{/for}"
  const ld = '<script type="application/ld+json">' + JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "SoftwareApplication", "name": "Niral", "applicationCategory": "DeveloperApplication", "operatingSystem": "Node.js 22+", "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }, "description": "A zero-dependency, compiler-first full-stack web framework. Svelte-class performance, batteries included (SSR, auth, database, realtime, jobs, AI), deploy in three commands.", "url": "https://niral.site", "downloadUrl": "https://www.npmjs.com/package/create-niral", "author": { "@type": "Organization", "name": "ZyoraLabs", "url": "https://zyoralabs.com" } },
      { "@type": "WebSite", "name": "Niral", "url": "https://niral.site", "publisher": { "@type": "Organization", "name": "ZyoraLabs" } }
    ]
  }) + '<\/script>'
</script>

<head>
  <title>Niral — the zero-dependency full-stack framework</title>
  <meta name="description" content="Niral is a zero-dependency, compiler-first full-stack web framework — Svelte-class performance, faster than Next.js, with auth, database, realtime, jobs, AI and one-command cloud deploys built in. By ZyoraLabs." />
  <meta name="keywords" content="niral, full-stack framework, zero dependency framework, javascript framework, node.js framework, ssr framework, svelte alternative, next.js alternative, web framework, zyoralabs" />
  <meta name="author" content="ZyoraLabs" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#0a0c10" />
  <link rel="canonical" href="https://niral.site/" />
  <link rel="icon" type="image/png" href="/n.png" />
  <link rel="apple-touch-icon" href="/n.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Niral" />
  <meta property="og:title" content="Niral — the zero-dependency full-stack framework" />
  <meta property="og:description" content="Zero dependencies. Faster than Next.js. Auth, database, realtime, jobs, AI &amp; one-command cloud deploys — built in. By ZyoraLabs." />
  <meta property="og:url" content="https://niral.site/" />
  <meta property="og:image" content="https://niral.site/n.png" />
  <meta property="og:image:alt" content="Niral — the zero-dependency full-stack framework" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Niral — the zero-dependency full-stack framework" />
  <meta name="twitter:description" content="Zero dependencies. Faster than Next.js. Batteries included. Deploy in three commands." />
  <meta name="twitter:image" content="https://niral.site/n.png" />
</head>

<main>
  {@html ld}
  <nav class="nav">
    <div class="nav-inner">
      <a class="mark" href="/"><img class="brand-logo" src="/niral-logo.svg" alt="Niral" height="30" /></a>
      <input type="checkbox" id="navtoggle" class="nav-toggle" aria-hidden="true" />
      <label for="navtoggle" class="nav-burger" aria-label="Toggle menu"><span></span><span></span><span></span></label>
      <div class="nav-links">
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/benchmarks">Benchmarks</a>
        <a href="https://github.com/Zyora-Dev/niral">GitHub</a>
        <a class="nav-cta" href="/docs/getting-started">Get started</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="glow"></div>
    <p class="badge"><span class="pulse"></span>zero dependencies · one $5 box to a fleet</p>
    <img class="hero-logo" src="/n.png" alt="Niral" width="104" height="104" />
    <h1>The full-stack framework<br />with <em>zero</em> dependencies.</h1>
    <p class="sub">
      Compiler-first components. Fine-grained reactivity. SSR at Svelte speed —
      served <b>7.5× faster than Next.js</b>. Auth, jobs, realtime, AI and
      deploys built in, not bolted on. <b>node_modules not required.</b>
    </p>
    <div class="cta">
      <code class="install"><span class="prompt">$</span> npx create-niral my-app<span class="caret">▍</span></code>
      <a class="btn" href="/docs/getting-started">Get started →</a>
    </div>
    <p class="hero-note">One command — SSR, hydration, a server RPC and tests, running in seconds.<br />No npm? <code class="alt">curl -fsSL https://niral.zyora.club/install.sh | bash</code></p>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>SSR</span><span>◆</span><span>Postgres</span><span>◆</span><span>Passkeys</span><span>◆</span><span>Jobs & Cron</span><span>◆</span><span>Clustering</span><span>◆</span><span>Streaming RPC</span><span>◆</span><span>SQLite</span><span>◆</span><span>AI + RAG</span><span>◆</span><span>WebSockets</span><span>◆</span><span>Migrations</span><span>◆</span><span>i18n</span><span>◆</span><span>Mail</span><span>◆</span><span>TypeScript</span><span>◆</span><span>Atomic deploys</span><span>◆</span>
      <span>SSR</span><span>◆</span><span>Postgres</span><span>◆</span><span>Passkeys</span><span>◆</span><span>Jobs & Cron</span><span>◆</span><span>Clustering</span><span>◆</span><span>Streaming RPC</span><span>◆</span><span>SQLite</span><span>◆</span><span>AI + RAG</span><span>◆</span><span>WebSockets</span><span>◆</span><span>Migrations</span><span>◆</span><span>i18n</span><span>◆</span><span>Mail</span><span>◆</span><span>TypeScript</span><span>◆</span><span>Atomic deploys</span><span>◆</span>
    </div>
  </div>

  <section class="numbers">
    <div class="num"><b>2,200<i>/s</i></b><span>requests served, dynamic SSR — 7.5× Next.js, 3.8× SvelteKit</span></div>
    <div class="num"><b>6.6<i>ms</i></b><span>hydration for 1000 rows — ties Svelte, 3× faster than React</span></div>
    <div class="num"><b>0.2<i>s</i></b><span>production builds — atomic releases, one-symlink rollback</span></div>
    <div class="num"><b>0</b><span>dependencies — the entire framework is Node stdlib</span></div>
  </section>

  <section class="code-demo">
    <p class="eyebrow">The model</p>
    <h2>One file. Whole feature.</h2>
    <p class="section-sub">Data loading, a server function, realtime fan-out and an animated list — this is the complete source.</p>
    <div class="window-wrap">
      <div class="window-halo"></div>
      <div class="window">
        <div class="window-bar">
          <span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span>
          <span class="window-title">routes/todos.niral</span>
        </div>
        <pre><code>{@html demo}</code></pre>
      </div>
    </div>
  </section>

  <section class="pipeline">
    <p class="eyebrow">Workflow</p>
    <h2>From idea to production, one tool.</h2>
    <div class="steps">
      <div class="step"><code>niral create</code><span>scaffolded app with SSR, RPC & tests</span></div>
      <div class="arrow">→</div>
      <div class="step"><code>niral dev</code><span>HMR, error overlays, live channels</span></div>
      <div class="arrow">→</div>
      <div class="step"><code>niral test</code><span>boots your real app, CI-ready</span></div>
      <div class="arrow">→</div>
      <div class="step"><code>niral deploy</code><span>systemd + nginx + atomic releases</span></div>
    </div>
    <p class="pipeline-note">Plus <a href="/docs/cli">doctor · migrate · check · export</a> — and graceful drains on every restart, so a deploy never drops a request.</p>
  </section>

  <section class="grid-section">
    <p class="eyebrow">Capabilities</p>
    <h2>Batteries included. Actually included.</h2>
    <p class="section-sub">Everything below ships in the framework or scaffolds into code you own — never an npm install.</p>
    <div class="grid">
      <a class="card span2" href="/docs/server"><b>Server functions</b><span>RPC with compile-time stubs, streaming responses, form actions that work without JS — and the function body structurally never reaches the browser.</span></a>
      <a class="card" href="/docs/auth"><b>Auth built in</b><span>Passkeys, TOTP 2FA, OAuth, route guards — scaffolded into your project, zero deps.</span></a>
      <a class="card" href="/docs/realtime"><b>Realtime</b><span>Live channels on framework-owned WebSockets, with session-aware guards.</span></a>
      <a class="card span2" href="/docs/ai"><b>AI-native</b><span>ai.chat / stream / embed against any OpenAI-compatible endpoint. RAG included — and a fully-local llama.cpp option, one command away.</span></a>
      <a class="card" href="/docs/jobs"><b>Jobs & cron</b><span>Durable queue that survives deploys. Retries, backoff, dead-letters — no Redis. Share it across a cluster with one env var.</span></a>
      <a class="card" href="/docs/server"><b>Polyglot backends</b><span>Write server blocks in Python, Ruby or Go — same file, same sessions, same RPC.</span></a>
      <a class="card" href="/docs/typescript"><b>Real TypeScript</b><span>niral check drives the actual TS compiler — diagnostics map to your .niral lines.</span></a>
      <a class="card" href="/docs/deployment"><b>Atomic deploys</b><span>Hashed releases, one-symlink rollback, security headers and CSP nonces by default.</span></a>
      <a class="card span2" href="/docs/scaling"><b>Scales to a fleet</b><span>Start on one $5 box with SQLite. Add Postgres — managed or self-hosted, TLS built in, zero-dep driver. Then go multi-server: stateless nodes, realtime over LISTEN/NOTIFY, a shared job queue. Every tier opt-in, still zero dependencies.</span></a>
    </div>
  </section>

  <section class="bench">
    <p class="eyebrow">Performance</p>
    <h2>Measured, not marketed.</h2>
    <p class="section-sub">Production servers, real HTTP, dynamic SSR on every request — the same 1000-row page, 100 connections. <a href="/docs/benchmarks">Full methodology →</a></p>
    <div class="bars">
      <div class="bar-row"><span class="bar-label">niral</span><div class="bar-track"><div class="bar b-niral" style="width: 100%"></div></div><span class="bar-val">2,374 req/s</span></div>
      <div class="bar-row"><span class="bar-label">solidstart</span><div class="bar-track"><div class="bar b-other" style="width: 79%"></div></div><span class="bar-val">1,885 req/s</span></div>
      <div class="bar-row"><span class="bar-label">astro</span><div class="bar-track"><div class="bar b-other" style="width: 29%"></div></div><span class="bar-val">698 req/s</span></div>
      <div class="bar-row"><span class="bar-label">sveltekit</span><div class="bar-track"><div class="bar b-other" style="width: 25%"></div></div><span class="bar-val">599 req/s</span></div>
      <div class="bar-row"><span class="bar-label">next.js</span><div class="bar-track"><div class="bar b-other" style="width: 13%"></div></div><span class="bar-val">303 req/s</span></div>
    </div>
    <p class="bench-note">Zero errors, every framework, every run. The bench is in the repo — run it yourself.</p>
  </section>

  <section class="vps">
    <p class="eyebrow">Economics</p>
    <h2>Your whole product on a $5 server.</h2>
    <p class="section-sub">App, database, background jobs, realtime, deploys — one process, one tiny VPS. No managed services, no sidecars, no surprise bills.</p>
    <div class="vps-grid">
      <div class="vps-card v1">
        <div class="vps-num">~200<i>MB</i></div>
        <b>memory under load</b>
        <span>measured at 100 concurrent connections — fits a 512 MB VPS with room to spare. Next.js needs ~450 MB for the same page.</span>
        <div class="meter"><div class="meter-fill m-niral"></div></div>
        <div class="meter"><div class="meter-fill m-next"></div></div>
        <p class="meter-key"><em>niral</em> vs next.js — RSS after the same load test</p>
      </div>
      <div class="vps-card v2">
        <div class="vps-num">0.2<i>s</i></div>
        <b>builds on the server itself</b>
        <span>no bundler, no OOM. Webpack/Vite builds famously crash small VPSes — niral builds a hashed release in a blink, on the box it runs on.</span>
      </div>
      <div class="vps-card v3">
        <div class="vps-num">0</div>
        <b>sidecar services</b>
        <span>Jobs, sessions and database ride on SQLite by default — no Redis, no workers to babysit. Reach for Postgres only when you outgrow one box.</span>
      </div>
      <div class="vps-card v4">
        <div class="vps-num">1</div>
        <b>command to production</b>
        <span><code>niral deploy</code> generates the whole kit — provisioning script, systemd, nginx, atomic releases, graceful restarts. Your server, your rules.</span>
      </div>
    </div>
    <p class="bench-note">2,200 req/s was measured on a laptop — a small VPS at a fraction of that still serves hundreds of thousands of views a day.</p>
  </section>

  <section class="scale">
    <p class="eyebrow">Scale</p>
    <h2>One box today. A fleet when you're ready.</h2>
    <p class="section-sub">Same app, same code — Niral grows with you. Each tier is one env var, never a rewrite, and always zero&#8209;dependency.</p>
    <div class="tiers">
      <div class="tier">
        <span class="tier-step">Start</span>
        <b>One process · SQLite</b>
        <span class="tier-desc">A $5 box runs everything — app, database, jobs, realtime. Most products never need more.</span>
        <code class="tier-cmd">niral deploy</code>
      </div>
      <div class="tier-join"><span>→</span></div>
      <div class="tier">
        <span class="tier-step">Grow</span>
        <b>Add Postgres</b>
        <span class="tier-desc">Heavier data? Point at managed Postgres — Neon, Supabase, RDS — or your own. TLS built in, no <code>pg</code>.</span>
        <code class="tier-cmd">NIRAL_DATABASE_URL=…</code>
      </div>
      <div class="tier-join"><span>→</span></div>
      <div class="tier">
        <span class="tier-step">Fleet</span>
        <b>Go multi-server</b>
        <span class="tier-desc">Stateless nodes behind a load balancer. Realtime fans out over LISTEN/NOTIFY, jobs share one queue. No Redis.</span>
        <code class="tier-cmd">NIRAL_CLUSTER=1</code>
      </div>
    </div>
    <p class="bench-note">Opt-in at every step — you never switch frameworks, you flip a switch when you outgrow the last tier. <a href="/docs/scaling">How scaling works →</a></p>
  </section>

  <section class="cloud">
    <p class="eyebrow">Instant deploys</p>
    <h2>Your machine to a live URL in three commands.</h2>
    <p class="section-sub"><b>zHost</b> — ZyoraLabs' deployment cloud — detects Niral automatically, builds in seconds, and runs your app sandboxed at <code>{"<slug>"}.zyora.in</code>. No server, no nginx, no CI.</p>
    <div class="cloud-term">
      <div class="cloud-bar"><span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span><span class="cloud-title">zhost deploy</span></div>
      <div class="cloud-body">
        <p class="cl-line"><span class="cl-p">$</span><span class="cl-type t1">zhost login</span><span class="cl-caret c1"></span></p>
        <p class="cl-line"><span class="cl-p">$</span><span class="cl-type t2">zhost link my-app</span><span class="cl-caret c2"></span></p>
        <p class="cl-line"><span class="cl-p">$</span><span class="cl-type t3">zhost deploy</span><span class="cl-caret c3"></span></p>
        <p class="cl-line cl-d cl-out o1">› Packing source… uploading 3 KB</p>
        <p class="cl-line cl-d cl-out o2">queued → building → deploying → <b>live</b></p>
        <p class="cl-line cl-ok cl-out o3">✓ Live → https://my-app.zyora.in</p>
      </div>
    </div>
    <p class="bench-note">Start at <a href="https://console.zyoralabs.com">console.zyoralabs.com</a> — create a project, follow Settings. <a href="/docs/zhost">Full guide →</a></p>
  </section>

  <section class="philosophy">
    <div class="phil">
      <i>01</i>
      <b>Compiler, not runtime</b>
      <span>Components compile to direct DOM instructions and string-concat SSR. No virtual DOM, no diffing — the work happens once, at build time.</span>
    </div>
    <div class="phil">
      <i>02</i>
      <b>Nothing to trust but your own repo</b>
      <span>Zero dependencies means no supply chain, no audits, no upstream breakage. Every line that runs is a line you can read.</span>
    </div>
    <div class="phil">
      <i>03</i>
      <b>Secrets can't escape</b>
      <span>Reading env vars in client code is a compile error. Env files never build, never serve, never commit, never sync on deploy.</span>
    </div>
  </section>

  <section class="final-cta">
    <p class="tamil-sm">நிரல் · "program" in Tamil</p>
    <h2>Start with one command.</h2>
    <div class="cta">
      <code class="install"><span class="prompt">$</span> npx create-niral my-app</code>
      <a class="btn" href="/docs/getting-started">Read the docs →</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <img class="footer-logo" src="/niral-logo.svg" alt="Niral" height="30" />
        <p class="footer-tag">The zero-dependency full-stack framework.<br />Built in India. Made for everyone.</p>
      </div>
      <div class="footer-col">
        <b>Learn</b>
        <a href="/docs/getting-started">Getting started</a>
        <a href="/docs/components">Components</a>
        <a href="/docs/server">Server functions</a>
        <a href="/docs/zhost">Instant deploys</a>
        <a href="/docs/deployment">Deployment</a>
      </div>
      <div class="footer-col">
        <b>Framework</b>
        <a href="https://github.com/Zyora-Dev/niral">GitHub</a>
        <a href="https://marketplace.visualstudio.com/items?itemName=zyoralabs.niral-vscode">VS Code extension</a>
        <a href="/docs/benchmarks">Benchmarks</a>
        <a href="/docs/scaling">Scaling</a>
        <a href="/docs/cli">CLI reference</a>
        <a href="/docs/ai">AI & RAG</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 · Powered by <a class="zyora" href="https://zyoralabs.com">ZyoraLabs</a></span>
      <span class="footer-dot">·</span>
      <span>நிரல் — every line readable, every claim reproducible</span>
    </div>
  </footer>
</main>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #0a0c10; color: #e8eaed; background-image: radial-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px); background-size: 28px 28px; }
  :global(::selection) { background: #34d39933; }
  main { font-family: "Geist", "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif; line-height: 1.6; }
  section { max-width: 920px; margin: 0 auto; padding: 3.6rem 1.4rem; }
  h2 { font-size: 1.75rem; letter-spacing: -.018em; text-align: center; margin: 0 0 .5rem; }
  .section-sub { text-align: center; color: #9aa3ad; max-width: 560px; margin: 0 auto 2rem; font-size: .97rem; }
  .section-sub a { color: #34d399; text-decoration: none; }
  .eyebrow { text-align: center; color: #34d399; font-size: .74rem; font-weight: 650; text-transform: uppercase; letter-spacing: .16em; margin: 0 0 .6rem; }

  /* nav — sticky glass */
  .nav { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); background: rgba(10, 12, 16, .72); border-bottom: 1px solid rgba(255, 255, 255, .05); }
  .nav-inner { max-width: 980px; margin: 0 auto; padding: .85rem 1.4rem; display: flex; justify-content: space-between; align-items: center; position: relative; }
  .mark { display: flex; align-items: center; gap: .55rem; text-decoration: none; }
  .brand-logo { height: 30px; width: auto; display: block; }
  .mark-glyph { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 9px; background: linear-gradient(135deg, #34d399, #0ea5e9); color: #04120b; font-weight: 700; font-size: .95rem; }
  .mark-name { color: #e8eaed; font-weight: 650; letter-spacing: .01em; }
  .nav-links { display: flex; align-items: center; gap: 1.3rem; }
  .nav-links a { color: #9aa3ad; text-decoration: none; font-size: .92rem; transition: color .15s; }
  .nav-links a:hover { color: #e8eaed; }
  .nav-cta { background: #14181d; border: 1px solid #262c33; border-radius: 9px; padding: .42rem .9rem; color: #7ee2b8 !important; transition: border-color .15s, box-shadow .15s; }
  .nav-cta:hover { border-color: #34d399; box-shadow: 0 0 18px rgba(52, 211, 153, .18); }
  .nav-toggle { display: none; }
  .nav-burger { display: none; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 40px; padding: 8px; border: 1px solid #262c33; border-radius: 9px; background: #14181d; cursor: pointer; }
  .nav-burger span { display: block; height: 2px; width: 100%; background: #cbd2da; border-radius: 2px; transition: transform .2s, opacity .2s; }

  /* hero */
  .hero { text-align: center; padding-top: 4.4rem; position: relative; }
  .hero > * { animation: rise .7s cubic-bezier(.2, .7, .3, 1) both; }
  .hero > *:nth-child(2) { animation-delay: .05s; }
  .hero > *:nth-child(3) { animation-delay: .12s; }
  .hero > *:nth-child(4) { animation-delay: .2s; }
  .hero > *:nth-child(5) { animation-delay: .28s; }
  .hero > *:nth-child(6) { animation-delay: .38s; }
  .hero > *:nth-child(7) { animation-delay: .48s; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .glow { position: absolute; inset: -8rem 0 auto; height: 28rem; background: radial-gradient(ellipse 62% 55% at 50% 20%, rgba(52, 211, 153, .14), transparent 70%); pointer-events: none; animation: none; }
  .badge { display: inline-flex; align-items: center; gap: .5rem; background: #11151a; border: 1px solid #232930; border-radius: 999px; padding: .32rem .95rem; font-size: .78rem; color: #9aa3ad; letter-spacing: .03em; margin: 0 0 1.4rem; }
  .pulse { width: .48rem; height: .48rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52, 211, 153, .6); animation: pulse 2.2s ease-out infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0); } 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); } }
  .tamil { font-size: 2.8rem; margin: 0; background: linear-gradient(120deg, #34d399, #6ee7b7, #0ea5e9, #34d399); background-size: 280% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; letter-spacing: .05em; animation: rise .7s cubic-bezier(.2, .7, .3, 1) both, sheen 9s linear infinite; }
  .hero-logo { width: 104px; height: 104px; margin: 0 auto .3rem; display: block; animation: rise .7s cubic-bezier(.2, .7, .3, 1) both; filter: drop-shadow(0 10px 34px rgba(52, 211, 153, .28)); }
  @keyframes sheen { to { background-position: 280% 0; } }
  h1 { font-size: 3.2rem; line-height: 1.1; margin: .6rem 0 1.1rem; letter-spacing: -.028em; }
  h1 em { font-style: normal; background: linear-gradient(120deg, #34d399, #0ea5e9); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sub { color: #9aa3ad; max-width: 640px; margin: 0 auto 2.1rem; font-size: 1.08rem; }
  .sub b { color: #cdd3da; }
  .cta { display: flex; gap: .9rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .install { background: #14181d; border: 1px solid #262c33; border-radius: 11px; padding: .74rem 1.15rem; font-size: .95rem; color: #7ee2b8; box-shadow: 0 0 0 1px rgba(52, 211, 153, .0), 0 10px 30px rgba(0, 0, 0, .25); }
  .prompt { color: #5f6b76; margin-right: .5rem; }
  .caret { color: #34d399; margin-left: .18rem; animation: blink 1.15s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .btn { position: relative; overflow: hidden; background: #34d399; color: #04120b; padding: .74rem 1.35rem; border-radius: 11px; font-weight: 650; text-decoration: none; transition: transform .12s, box-shadow .12s; }
  .btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, .45) 50%, transparent 60%); transform: translateX(-130%); transition: transform .55s ease; }
  .btn:hover { transform: translateY(-1px); box-shadow: 0 8px 28px rgba(52, 211, 153, .3); }
  .btn:hover::after { transform: translateX(130%); }
  .hero-note { color: #5f6b76; font-size: .84rem; margin-top: 1.2rem; line-height: 2; }
  .hero-note :global(code.alt), .hero-note code.alt { background: #11151a; border: 1px solid #1b2027; border-radius: 7px; padding: .15rem .55rem; color: #9aa3ad; font-size: .78rem; }

  /* capability marquee */
  .marquee { overflow: hidden; padding: 1.1rem 0 .4rem; -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent); }
  .marquee-track { display: flex; align-items: center; gap: 2rem; width: max-content; animation: marquee 34s linear infinite; }
  .marquee-track span { color: #5f6b76; font-size: .86rem; letter-spacing: .04em; white-space: nowrap; }
  .marquee-track span:nth-child(even) { color: #234135; font-size: .6rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* stat tiles */
  .numbers { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
  .num { background: #11151a; border: 1px solid #232930; border-radius: 15px; padding: 1.35rem 1.2rem; text-align: center; transition: border-color .15s, transform .15s; }
  .num:hover { border-color: #2c3742; transform: translateY(-2px); }
  .num b { display: block; font-size: 2rem; color: #34d399; letter-spacing: -.02em; }
  .num b i { font-style: normal; font-size: 1.05rem; color: #6ee7b7; }
  .num span { color: #9aa3ad; font-size: .85rem; display: block; margin-top: .3rem; }

  /* code window */
  .window-wrap { position: relative; overflow-x: clip; }
  .window-halo { position: absolute; inset: -1.6rem -2.2rem; background: radial-gradient(ellipse 60% 70% at 50% 45%, rgba(52, 211, 153, .09), transparent 70%); filter: blur(6px); pointer-events: none; }
  .window { position: relative; background: #0e1115; border: 1px solid #232930; border-radius: 15px; overflow: hidden; box-shadow: 0 24px 70px rgba(0, 0, 0, .45); transition: transform .25s ease, border-color .25s ease; }
  .window:hover { transform: translateY(-3px); border-color: #2c3742; }
  .window-bar { display: flex; align-items: center; gap: .42rem; padding: .68rem 1rem; border-bottom: 1px solid #1b2027; background: #11151a; }
  .dot { width: .68rem; height: .68rem; border-radius: 50%; }
  .d1 { background: #f6726f; } .d2 { background: #f5bd4f; } .d3 { background: #55ca62; }
  .window-title { margin-left: .6rem; color: #5f6b76; font-size: .8rem; font-family: ui-monospace, monospace; }
  pre { margin: 0; padding: 1.25rem 1.4rem; overflow-x: auto; font-size: .88rem; line-height: 1.6; }
  code { color: #d7dde3; font-family: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace; }
  pre :global(.c) { color: #5f6b76; font-style: italic; }
  pre :global(.k) { color: #7aa2f7; }
  pre :global(.f) { color: #e0af68; }
  pre :global(.r) { color: #34d399; font-weight: 500; }

  /* pipeline */
  .steps { display: flex; align-items: stretch; justify-content: center; gap: .5rem; margin-top: 1.6rem; }
  .step { flex: 1 1 0; min-width: 0; background: #11151a; border: 1px solid #232930; border-radius: 13px; padding: .95rem 1rem; text-align: center; }
  .step code { display: block; color: #7ee2b8; font-size: .9rem; margin-bottom: .25rem; }
  .step span { color: #9aa3ad; font-size: .78rem; }
  .arrow { flex: 0 0 auto; align-self: center; color: #34d399; font-size: 1.1rem; }
  .pipeline-note { text-align: center; color: #9aa3ad; font-size: .88rem; margin-top: 1.5rem; }
  .pipeline-note a { color: #34d399; text-decoration: none; }
  @media (max-width: 640px) { .steps { flex-direction: column; } .arrow { transform: rotate(90deg); } }

  /* feature bento */
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .card { position: relative; background: #11151a; border: 1px solid #232930; border-radius: 15px; padding: 1.2rem 1.25rem; text-decoration: none; color: inherit; transition: border-color .18s, transform .18s, box-shadow .18s; overflow: hidden; }
  .card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #34d399, #0ea5e9); transform: scaleX(0); transform-origin: left; transition: transform .3s ease; }
  .card:hover { border-color: #2c3742; transform: translateY(-3px); box-shadow: 0 14px 40px rgba(0, 0, 0, .3); }
  .card:hover::before { transform: scaleX(1); }
  .card.span2 { grid-column: span 2; background: linear-gradient(180deg, #121820, #11151a); }
  .card b { display: block; margin-bottom: .3rem; color: #e8eaed; }
  .card span { color: #9aa3ad; font-size: .88rem; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } .card.span2 { grid-column: span 2; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .card.span2 { grid-column: auto; } }

  /* benchmark bars */
  .bars { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; gap: .85rem; }
  .bar-row { display: grid; grid-template-columns: 88px 1fr 110px; align-items: center; gap: .9rem; }
  .bar-label { color: #cdd3da; font-size: .88rem; text-align: right; }
  .bar-track { background: #11151a; border: 1px solid #1b2027; border-radius: 999px; height: 1.05rem; overflow: hidden; }
  .bar { height: 100%; border-radius: 999px; }
  .b-niral { position: relative; overflow: hidden; background: linear-gradient(90deg, #34d399, #6ee7b7); }
  .b-niral::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, .35) 50%, transparent 70%); transform: translateX(-120%); animation: shimmer 2.8s ease-in-out infinite; }
  @keyframes shimmer { 40%, 100% { transform: translateX(120%); } }
  .b-other { background: #2c3742; }
  .bar-val { color: #9aa3ad; font-size: .85rem; }
  .bench-note { text-align: center; color: #5f6b76; font-size: .84rem; margin-top: 1.6rem; }

  /* small-server economics — animated cards */
  .vps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (max-width: 560px) { .vps-grid { grid-template-columns: 1fr; } }
  .vps-card { position: relative; background: #11151a; border: 1px solid #232930; border-radius: 16px; padding: 1.4rem 1.3rem 1.3rem; overflow: hidden; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .vps-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(140px 90px at 20% 0%, rgba(52, 211, 153, .10), transparent 70%); opacity: 0; transition: opacity .25s; pointer-events: none; }
  .vps-card:hover { transform: translateY(-4px); border-color: #34d39966; box-shadow: 0 14px 44px rgba(0, 0, 0, .35); }
  .vps-card:hover::before { opacity: 1; }
  .vps-num { font-size: 2.3rem; font-weight: 700; letter-spacing: -.03em; background: linear-gradient(120deg, #34d399, #6ee7b7); -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1.1; }
  .vps-num i { font-style: normal; font-size: 1.15rem; }
  .vps-card b { display: block; color: #e8eaed; margin: .35rem 0 .35rem; }
  .vps-card span { color: #9aa3ad; font-size: .86rem; display: block; }
  .vps-card code { color: #7ee2b8; background: #0e1115; padding: .05rem .4rem; border-radius: 6px; font-size: .82rem; }
  .meter { background: #0e1115; border: 1px solid #1b2027; border-radius: 999px; height: .5rem; margin-top: .7rem; overflow: hidden; }
  .meter + .meter { margin-top: .4rem; }
  .meter-fill { height: 100%; border-radius: 999px; width: 0; }
  .m-niral { background: linear-gradient(90deg, #34d399, #6ee7b7); animation: fill-niral 1.1s .2s cubic-bezier(.2, .7, .3, 1) forwards; }
  .m-next { background: #2c3742; animation: fill-next 1.1s .35s cubic-bezier(.2, .7, .3, 1) forwards; }
  @keyframes fill-niral { to { width: 44%; } }
  @keyframes fill-next { to { width: 100%; } }
  .meter-key { color: #5f6b76; font-size: .74rem; margin: .5rem 0 0; }
  .meter-key em { color: #34d399; font-style: normal; }
  /* staggered scroll-in where the browser supports it — graceful no-op elsewhere */
  @supports (animation-timeline: view()) {
    .vps-card { animation: card-rise both; animation-timeline: view(); animation-range: entry 0% entry 55%; }
    .v2 { animation-range: entry 8% entry 63%; }
    .v3 { animation-range: entry 16% entry 71%; }
    .v4 { animation-range: entry 24% entry 79%; }
  }
  @keyframes card-rise { from { opacity: 0; transform: translateY(26px) scale(.97); } to { opacity: 1; transform: none; } }

  /* scale — growth tiers */
  .tiers { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: .6rem; }
  .tier { position: relative; background: linear-gradient(180deg, #121820, #11151a); border: 1px solid #232930; border-radius: 16px; padding: 1.3rem 1.2rem; overflow: hidden; transition: transform .18s, border-color .18s, box-shadow .18s; }
  .tier::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, #34d399, #0ea5e9); transform: scaleX(0); transform-origin: left; transition: transform .3s ease; }
  .tier:hover { transform: translateY(-4px); border-color: #34d39966; box-shadow: 0 16px 44px rgba(0, 0, 0, .35); }
  .tier:hover::before { transform: scaleX(1); }
  .tier-step { display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: #04120b; background: linear-gradient(120deg, #34d399, #6ee7b7); padding: .2rem .6rem; border-radius: 999px; margin-bottom: .75rem; }
  .tier b { display: block; color: #e8eaed; font-size: 1.05rem; margin-bottom: .4rem; }
  .tier-desc { color: #9aa3ad; font-size: .87rem; display: block; margin-bottom: 1rem; }
  .tier-desc code, .card code { color: #7ee2b8; background: #0e1115; padding: .02rem .32rem; border-radius: 5px; font-size: .82em; }
  .tier-cmd { display: block; color: #7ee2b8; background: #0e1115; border: 1px solid #1b2027; padding: .5rem .65rem; border-radius: 9px; font-size: .8rem; font-family: ui-monospace, "SF Mono", monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tier-join { display: flex; align-items: center; justify-content: center; color: #34d399aa; font-size: 1.35rem; }
  @supports (animation-timeline: view()) {
    .tier { animation: card-rise both; animation-timeline: view(); animation-range: entry 2% entry 60%; }
  }
  @media (max-width: 720px) {
    .tiers { grid-template-columns: 1fr; }
    .tier-join { transform: rotate(90deg); padding: .15rem 0; }
  }

  /* instant deploys — zhost */
  .cloud-term { max-width: 620px; margin: 1.8rem auto 0; background: #0d1014; border: 1px solid #232930; border-radius: 16px; overflow: hidden; box-shadow: 0 18px 50px rgba(0, 0, 0, .35); }
  .cloud-bar { display: flex; align-items: center; gap: .42rem; padding: .6rem .9rem; background: #11151a; border-bottom: 1px solid #1b2027; }
  .cloud-title { margin-left: .5rem; color: #5f6b76; font-size: .76rem; font-family: ui-monospace, "SF Mono", monospace; }
  .cloud-body { padding: 1.1rem 1.2rem 1.2rem; overflow-x: auto; min-height: 11.4em; }
  .cl-line { margin: 0; font-family: "Geist Mono", ui-monospace, "SF Mono", monospace; font-size: .86rem; line-height: 1.9; color: #cdd3da; white-space: nowrap; }
  .cl-p { color: #34d399; margin-right: .6ch; }
  .cl-d { color: #5f6b76; }
  .cl-ok { color: #6ee7b7; font-weight: 600; }
  /* typed commands — the whole sequence loops on a 12s cycle (terminal "clears" and replays) */
  .cl-type { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; width: 0; }
  .t1 { animation: type-t1 12s infinite; }
  .t2 { animation: type-t2 12s infinite; }
  .t3 { animation: type-t3 12s infinite; }
  @keyframes type-t1 { 0%, 5% { width: 0; animation-timing-function: steps(11, end); } 12.5%, 94% { width: 11ch; } 96%, 100% { width: 0; } }
  @keyframes type-t2 { 0%, 18.3% { width: 0; animation-timing-function: steps(17, end); } 28.3%, 94% { width: 17ch; } 96%, 100% { width: 0; } }
  @keyframes type-t3 { 0%, 35% { width: 0; animation-timing-function: steps(12, end); } 42.5%, 94% { width: 12ch; } 96%, 100% { width: 0; } }
  /* the block caret blinks on the active line, then hops to the next */
  .cl-caret { display: inline-block; width: .55ch; height: 1.05em; margin-left: 1px; background: #34d399; vertical-align: text-bottom; opacity: 0; }
  .c1 { animation: caret-c1 12s step-end infinite; }
  .c2 { animation: caret-c2 12s step-end infinite; }
  .c3 { animation: caret-c3 12s step-end infinite; }
  @keyframes caret-c1 { 0% { opacity: 1; } 2.5% { opacity: 0; } 4%, 12.5% { opacity: 1; } 14%, 100% { opacity: 0; } }
  @keyframes caret-c2 { 0%, 14% { opacity: 0; } 16% { opacity: 1; } 17.5% { opacity: 0; } 19%, 28.3% { opacity: 1; } 30%, 100% { opacity: 0; } }
  @keyframes caret-c3 { 0%, 30% { opacity: 0; } 32% { opacity: 1; } 33.5% { opacity: 0; } 35%, 42.5% { opacity: 1; } 44%, 100% { opacity: 0; } }
  /* output lines appear after `zhost deploy` finishes, then clear with the loop */
  .cl-out { opacity: 0; }
  .o1 { animation: out-o1 12s ease-out infinite; }
  .o2 { animation: out-o2 12s ease-out infinite; }
  .o3 { animation: out-o3 12s ease-out infinite; }
  @keyframes out-o1 { 0%, 48% { opacity: 0; transform: translateY(4px); } 51.5%, 94% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes out-o2 { 0%, 55% { opacity: 0; transform: translateY(4px); } 58.5%, 94% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes out-o3 { 0%, 63.3% { opacity: 0; transform: translateY(4px); } 67%, 94% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .cl-type { width: auto !important; animation: none; }
    .cl-out { opacity: 1; transform: none; animation: none; }
    .cl-caret { display: none; }
  }
  .cloud .section-sub code { color: #7ee2b8; background: #0e1115; padding: .05rem .35rem; border-radius: 5px; font-size: .85em; }
  .cloud .section-sub b { color: #e8eaed; }

  /* philosophy */
  .philosophy { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.6rem; border-top: 1px solid #1b2027; border-bottom: 1px solid #1b2027; }
  .phil i { display: block; font-style: normal; color: #234135; font-weight: 700; font-size: 1.6rem; letter-spacing: .02em; margin-bottom: .35rem; }
  .phil b { display: block; color: #e8eaed; margin-bottom: .4rem; font-size: 1.02rem; }
  .phil span { color: #9aa3ad; font-size: .9rem; }

  /* final cta */
  .final-cta { text-align: center; }
  .tamil-sm { color: #34d399; font-size: .95rem; margin: 0 0 .4rem; letter-spacing: .04em; }
  .final-cta h2 { margin-bottom: 1.6rem; }

  /* footer */
  .footer { position: relative; overflow: hidden; border-top: 1px solid #1b2027; background: #090b0e; margin-top: 2rem; }
  .footer::before { content: "நிரல்"; position: absolute; left: 50%; bottom: -4.5rem; transform: translateX(-50%); font-size: 12rem; font-weight: 700; color: rgba(52, 211, 153, .04); letter-spacing: .04em; pointer-events: none; white-space: nowrap; }
  .footer-inner { max-width: 920px; margin: 0 auto; padding: 3rem 1.4rem 2rem; display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 2rem; }
  .footer-mark { display: flex; align-items: center; gap: .55rem; font-weight: 650; margin: 0 0 .7rem; }
  .footer-logo { height: 30px; width: auto; display: block; margin: 0 0 .9rem; }
  .footer-tag { color: #9aa3ad; font-size: .88rem; margin: 0; }
  .footer-col { display: flex; flex-direction: column; gap: .45rem; }
  .footer-col b { color: #cdd3da; font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .3rem; }
  .footer-col a { color: #9aa3ad; text-decoration: none; font-size: .9rem; transition: color .15s; }
  .footer-col a:hover { color: #34d399; }
  .footer-bottom { max-width: 920px; margin: 0 auto; padding: 1.2rem 1.4rem 2rem; border-top: 1px solid #14181d; color: #5f6b76; font-size: .84rem; display: flex; gap: .6rem; flex-wrap: wrap; }
  .zyora { color: #34d399; text-decoration: none; font-weight: 600; }
  .zyora:hover { text-decoration: underline; }
  .footer-dot { color: #2c3742; }

  @media (max-width: 720px) {
    h1 { font-size: 2.3rem; }
    .footer-inner { grid-template-columns: 1fr; gap: 1.6rem; }
    .arrow { display: none; }
    .nav-burger { display: flex; }
    .nav-links { position: absolute; top: calc(100% + 6px); right: 1rem; left: 1rem; flex-direction: column; align-items: stretch; gap: .2rem; background: #0d1116; border: 1px solid #1c232b; border-radius: 12px; padding: .5rem; box-shadow: 0 20px 50px rgba(0,0,0,.5); display: none; z-index: 60; }
    #navtoggle:checked ~ .nav-links { display: flex; }
    .nav-links a { padding: .7rem .8rem; border-radius: 8px; font-size: 1rem; }
    .nav-links a:hover { background: #14181d; }
    .nav-cta { text-align: center; margin-top: .2rem; }
    #navtoggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    #navtoggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    #navtoggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01s !important; animation-iteration-count: 1 !important; transition-duration: .01s !important; }
  }
</style>
