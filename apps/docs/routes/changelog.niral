<server>
let commitCache = null
let commitCacheAt = 0
const CACHE_MS = 10 * 60 * 1000

function parseCommit(c) {
  const subject = String(c?.commit?.message ?? "").split("\n")[0].trim()
  if (!subject || /^(wip|tmp|fixup|squash)\b|^Merge\b/i.test(subject)) return null
  const m = subject.match(/^([\w+/-]+):\s*(.+)$/)
  return {
    hash: String(c.sha ?? "").slice(0, 7),
    date: String(c?.commit?.committer?.date ?? c?.commit?.author?.date ?? "").slice(0, 10),
    area: m ? m[1].toLowerCase() : "core",
    text: m ? m[2] : subject,
  }
}

async function currentEntries() {
  const now = Date.now()
  if (commitCache && now - commitCacheAt < CACHE_MS) return { entries: commitCache, source: "GitHub" }
  try {
    const res = await fetch("https://api.github.com/repos/Zyora-Dev/niral/commits?per_page=100", {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "niral-site-changelog",
        "X-GitHub-Api-Version": "2022-11-28",
      },
    })
    if (!res.ok) throw new Error(`GitHub ${res.status}`)
    const entries = (await res.json()).map(parseCommit).filter(Boolean)
    if (!entries.length) throw new Error("GitHub returned no commits")
    commitCache = entries
    commitCacheAt = now
    return { entries, source: "GitHub" }
  } catch {
    const { ENTRIES } = await projectImport("lib/changelog.js")
    return { entries: ENTRIES, source: "release fallback" }
  }
}

export async function load() {
  const { ENTRIES: fallback, GENERATED_AT } = await projectImport("lib/changelog.js")
  const { entries, source } = await currentEntries()
  // group by month, newest first
  const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"]
  const groups = []
  let cur = null
  for (const e of entries) {
    const [y, m, d] = e.date.split("-")
    const key = `${MONTHS[Number(m) - 1]} ${y}`
    if (!cur || cur.key !== key) { cur = { key, items: [] }; groups.push(cur) }
    cur.items.push({ ...e, day: `${MONTHS[Number(m) - 1].slice(0, 3)} ${Number(d)}` })
  }
  return {
    groups,
    generatedAt: source === "GitHub" ? new Date().toISOString().slice(0, 10) : GENERATED_AT,
    total: entries.length,
    source,
    fallbackTotal: fallback.length,
  }
}
</server>

<script>
  import Seo from "../components/Seo.niral"
  const seoTitle = "Niral Changelog | Framework Updates and Fixes"
  const description = "Follow Niral framework updates, new capabilities and fixes from the repository's commit history. Browse changes by month and open the source on GitHub."
  let { groups, generatedAt, total, source } = $props
</script>

<head>
  <title>Niral Changelog | Framework Updates and Fixes</title>
  <meta name="description" content="Follow Niral framework updates, new capabilities and fixes from the repository's commit history. Browse changes by month and open the source on GitHub." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#090909" />
  <link rel="canonical" href="https://niral.site/changelog" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Niral" />
  <meta property="og:title" content="Niral Changelog | Framework Updates and Fixes" />
  <meta property="og:description" content="Follow Niral framework updates, new capabilities and fixes from the repository's commit history. Browse changes by month and open the source on GitHub." />
  <meta property="og:url" content="https://niral.site/changelog" />
  <meta property="og:image" content="https://niral.site/n.png" />
  <meta property="og:image:alt" content="Niral web framework logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Niral Changelog | Framework Updates and Fixes" />
  <meta name="twitter:description" content="Follow Niral framework updates, new capabilities and fixes from the repository's commit history. Browse changes by month and open the source on GitHub." />
  <meta name="twitter:image" content="https://niral.site/n.png" />
  <meta name="twitter:image:alt" content="Niral web framework logo" />
</head>
<Seo title={seoTitle} description={description} path="/changelog" pageType="CollectionPage" />

<main>
  <nav class="nav" aria-label="Main navigation">
    <div class="nav-inner">
      <a class="mark" href="/"><img class="brand-logo" src="/niral-logo.png" alt="Niral" height="30" /></a>
      <div class="nav-links">
        <a href="/docs/getting-started">Docs</a>
        <a href="/docs/benchmarks">Benchmarks</a>
        <a href="/changelog" aria-current="page">Changelog</a>
        <a href="https://github.com/Zyora-Dev/niral" rel="noopener">GitHub</a>
        <a class="nav-cta" href="/docs/getting-started">Get started</a>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Navigation menu"><img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/menu.svg" alt="" width="22" height="22" /></summary>
        <div class="mobile-links">
          <a href="/">Home</a>
          <a href="/docs/getting-started">Documentation</a>
          <a href="/docs/benchmarks">Benchmarks</a>
          <a href="/changelog" aria-current="page">Changelog</a>
          <a href="https://github.com/Zyora-Dev/niral">GitHub</a>
        </div>
      </details>
    </div>
  </nav>

  <header class="hero">
    <p class="eyebrow"><img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/git-branch.svg" alt="" width="18" height="18" /> The Niral release log</p>
    <h1>Changelog<span>.</span></h1>
    <p class="lead">The framework, as it evolves.<br />New capabilities, thoughtful improvements, and fixes from the repository.</p>
    <div class="release-meta">
      <p><b>{total}</b> changes <span>·</span> {source}</p>
      <p>Refreshed <time datetime={generatedAt}>{generatedAt}</time></p>
      <a href="https://github.com/Zyora-Dev/niral/commits">View on GitHub <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/arrow-up-right.svg" alt="" width="16" height="16" /></a>
    </div>
  </header>

  <section class="log" aria-label="Release history">
    {#for g of groups key g.key}
      <div class="month">
        <div class="month-heading"><h2>{g.key}</h2><p>{g.items.length} changes</p></div>
        <ul>
          {#for e of g.items key e.hash}
            <li>
              <time class="day" datetime={e.date}>{e.day}</time>
              <span class="area" data-a="{e.area}">{e.area}</span>
              <span class="text">{e.text}</span>
              <a class="hash" href={"https://github.com/Zyora-Dev/niral/commit/" + e.hash} aria-label={"View commit " + e.hash}>{e.hash}<span aria-hidden="true">↗</span></a>
            </li>
          {/for}
        </ul>
      </div>
    {/for}
  </section>

  <footer class="foot">
    <a href="/"><img class="brand-logo" src="/niral-logo.png" alt="Niral home" height="30" /></a>
    <span>Built in India. Made for everyone.</span>
    <a href="/docs/getting-started">Read the docs ↗</a>
  </footer>
</main>

<style>
  :global(html) { color-scheme: dark; }
  :global(body) { margin: 0; background: #080809; color: #fafafa; }
  :global(::selection) { background: #f2b544; color: #080809; }
  * { box-sizing: border-box; }
  main { --gold: #f2b544; --line: #363639; min-height: 100vh; font-family: "Geist", sans-serif; letter-spacing: 0; line-height: 1.6; background: linear-gradient(125deg, #232326, #101012 1000px, #080809 2000px); }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--gold); }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--gold); outline-offset: 5px; }
  .nav { position: sticky; top: 0; z-index: 50; background: #0b0b0df5; border-bottom: 1px solid var(--line); backdrop-filter: blur(14px); }
  .nav-inner { max-width: 1184px; min-height: 80px; margin: auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; position: relative; gap: 24px; }
  .mark { display: flex; }
  .brand-logo { display: block; height: 30px; width: auto; }
  .nav-links { display: flex; align-items: center; gap: 30px; }
  .nav-links a { font-size: 14px; }
  a[aria-current="page"] { color: var(--gold); }
  .nav-cta { background: #232326; border: 1px solid #505054; border-radius: 6px; padding: 10px 18px; font-weight: 500; }
  .nav-cta:hover { border-color: var(--gold); }
  .mobile-nav { display: none; }
  .mobile-nav summary { list-style: none; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 6px; cursor: pointer; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav img, .eyebrow img, .release-meta img { filter: invert(1); }
  .mobile-links { position: absolute; top: calc(100% - 1px); left: 16px; right: 16px; padding: 12px; display: flex; flex-direction: column; gap: 4px; background: #18181b; border: 1px solid #505054; border-radius: 8px; box-shadow: 0 20px 40px #0008; }
  .mobile-links a { padding: 12px 16px; font-size: 15px; border-radius: 4px; }
  .mobile-links a:hover { background: #303033; }
  .hero { max-width: 1184px; margin: auto; padding: 72px 32px 0; }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--gold); font-size: 13px; font-weight: 500; margin: 0 0 22px; }
  h1 { font-size: 64px; font-weight: 500; line-height: 1.12; margin: 0 0 24px; }
  h1 span { color: var(--gold); }
  .lead { font-size: 17px; margin: 0 0 44px; max-width: 620px; line-height: 1.8; }
  .release-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; font-size: 13px; padding-block: 22px; border-block: 1px solid var(--line); }
  .release-meta p { margin: 0; }
  .release-meta b { font-weight: 600; }
  .release-meta span { margin-inline: 8px; }
  .release-meta a { margin-left: auto; display: inline-flex; align-items: center; gap: 10px; }
  .log { max-width: 1184px; margin: auto; padding: 24px 32px 72px; }
  .month { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 56px; padding-block: 40px; }
  .month + .month { border-top: 1px solid var(--line); }
  .month-heading { align-self: start; position: sticky; top: 112px; padding-top: 4px; }
  .month h2 { font-size: 20px; font-weight: 500; line-height: 1.3; margin: 0 0 12px; }
  .month-heading p { margin: 0; font-size: 13px; }
  .month ul { margin: 0; padding: 0 0 0 28px; list-style: none; border-left: 1px solid #505054; }
  .month li { position: relative; display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 12px 20px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .month li:first-child { padding-top: 0; }
  .month li:last-child { border-bottom: 0; }
  .month li::before { content: ""; position: absolute; left: -33px; top: 35px; width: 7px; height: 7px; background: var(--gold); border: 1px solid var(--gold); border-radius: 50%; }
  .month li:first-child::before { top: 11px; }
  .day { font: 12px "Geist Mono", monospace; white-space: nowrap; }
  .area { justify-self: start; font-size: 12px; font-weight: 500; padding: 3px 10px; border-radius: 4px; background: #232326; border: 1px solid #505054; overflow-wrap: anywhere; max-width: 100%; }
  .text { grid-column: 1 / -1; grid-row: 2; line-height: 1.75; font-size: 16px; min-width: 0; overflow-wrap: anywhere; max-width: 720px; }
  .hash { display: inline-flex; align-items: center; gap: 8px; grid-column: 3; grid-row: 1; font: 12px "Geist Mono", monospace; }
  .hash span { color: var(--gold); }
  .foot { max-width: 1120px; margin: auto; padding: 32px 0; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 24px; font-size: 13px; }
  @media (max-width: 1000px) {
    .nav-links { gap: 20px; }
    .month { grid-template-columns: 170px minmax(0, 1fr); gap: 32px; }
    .foot { margin-inline: 32px; }
  }
  @media (max-width: 720px) {
    .nav-inner { min-height: 72px; padding: 14px 24px; }
    .nav-links { display: none; }
    .mobile-nav { display: block; }
    .hero { padding: 44px 24px 0; }
    h1 { font-size: 44px; }
    .lead { font-size: 15px; margin-bottom: 28px; }
    .release-meta { gap: 12px 24px; }
    .release-meta a { margin-left: 0; }
    .log { padding: 0 24px 48px; }
    .month { grid-template-columns: 1fr; gap: 28px; padding-block: 36px; }
    .month-heading { position: static; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
    .month h2 { margin: 0; }
    .month ul { padding-left: 20px; }
    .month li { grid-template-columns: 60px minmax(0, 1fr) auto; gap: 12px; }
    .month li::before { left: -25px; }
    .text { font-size: 15px; }
    .area { font-size: 11px; padding: 3px 8px; }
    .hash { font-size: 11px; gap: 4px; }
    .foot { flex-wrap: wrap; margin-inline: 24px; padding-block: 28px; }
  }
  @media (max-width: 360px) {
    .hero, .log { padding-inline: 20px; }
    h1 { font-size: 38px; }
    .month li { grid-template-columns: 56px minmax(0, 1fr) auto; gap: 10px; }
    .hash span { display: none; }
  }
</style>
