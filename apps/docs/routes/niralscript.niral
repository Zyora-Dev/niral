<script>
  import SiteHeader from "../components/SiteHeader.niral"
  import SiteFooter from "../components/SiteFooter.niral"
  import Seo from "../components/Seo.niral"
  import NiralScriptPlayground from "../components/NiralScriptPlayground.niral"
  const seoTitle = "NiralScript | Independent Frontend Language by ZyoraLabs"
  const description = "Explore NiralScript: an independent frontend language with reactive state, gradual types, async functions, standalone JavaScript compilation and verified JS/TS benchmarks."
  const example = '<script lang="niralscript">\n  state count: number = 0\n  derive doubled: number = count * 2\n</script>\n\n<button on:click={() => count += 1}>Increase</button>\n<p>{count} doubled is {doubled}</p>'
  const typedExample = 'state items: number[] = []\n\nitems.push(1, 2)\nitems.unshift(0)\nitems.splice(1, 1, 3)\nitems.fill(4, 1)\n\nitems.push("bad")\n// Compile error: Expected number, received string'
  const standaloneExample = 'input initial: number\nstate count: number = initial\nderive doubled: number = count * 2\n\nexport function increment(): number {\n  count += 1\n  return doubled\n}'
  const contractExample = 'type Order = { quantity: number, note?: string }\n\nexport function readOrder(candidate: unknown): Order {\n  return contract<Order>(candidate)\n}\n\nconst accepted = readOrder({ quantity: 2 })'
</script>

<head>
  <title>NiralScript | Independent Frontend Language by ZyoraLabs</title>
  <meta name="description" content="Explore NiralScript: an independent frontend language with reactive state, gradual types, async functions, standalone JavaScript compilation and verified JS/TS benchmarks." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#090909" />
  <link rel="canonical" href="https://niral.site/niralscript" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Niral" />
  <meta property="og:title" content="NiralScript | Independent Frontend Language by ZyoraLabs" />
  <meta property="og:description" content="Explore NiralScript: an independent frontend language with reactive state, gradual types, async functions, standalone JavaScript compilation and verified JS/TS benchmarks." />
  <meta property="og:url" content="https://niral.site/niralscript" />
  <meta property="og:image" content="https://niral.site/n.png" />
  <meta property="og:image:alt" content="Niral web framework logo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="NiralScript | Independent Frontend Language by ZyoraLabs" />
  <meta name="twitter:description" content="Explore NiralScript: an independent frontend language with reactive state, gradual types, async functions, standalone JavaScript compilation and verified JS/TS benchmarks." />
  <meta name="twitter:image" content="https://niral.site/n.png" />
  <meta name="twitter:image:alt" content="Niral web framework logo" />
</head>
<Seo title={seoTitle} description={description} path="/niralscript" />

<div class="language-page">
  <a class="skip-link" href="#language-main">Skip to content</a>
  <SiteHeader current="niralscript" />
  <main id="language-main" class="frame">
    <header class="introduction">
      <p class="eyebrow">ZYORALABS / LANGUAGE DEVELOPMENT</p>
      <h1>NiralScript<span>.</span></h1>
      <p class="lead">An independent frontend language.<br />Niral is the first integration.</p>
      <p class="opening">Explicit reactive state, gradual types and ordinary JavaScript output. NiralScript has its own parser, semantic checker and standalone compiler, with zero runtime dependencies.</p>
      <dl class="identity">
        <div><dt>Language extension</dt><dd>.nrs</dd></div>
        <div><dt>First framework</dt><dd>Niral</dd></div>
        <div><dt>Current stage</dt><dd>Experimental language</dd></div>
      </dl>
    </header>

    <NiralScriptPlayground />

    <section class="editorial" aria-labelledby="language-title">
      <p class="section-label"><span>01</span> LANGUAGE & FRAMEWORK</p>
      <div class="section-content">
        <h2 id="language-title">Its own language.<br />Not another component extension.</h2>
        <p><code>.nrs</code> belongs to NiralScript. <code>.niral</code> remains Niral's component format, bringing together templates, styles and server code. They have different responsibilities.</p>
        <p>The language core has its own directory, parser, scanner, type checker and diagnostics, with no imports from the Niral framework. Its standalone compiler emits JavaScript ES modules. A separate Niral adapter connects the language to Niral's fine-grained runtime.</p>
        <p>Niral comes first. Other framework targets, including React for Next.js, are planned. They are not available integrations today.</p>
      </div>
    </section>

    <section class="editorial" aria-labelledby="example-title">
      <p class="section-label"><span>02</span> REACTIVE BY DESIGN</p>
      <div class="section-content">
        <h2 id="example-title">State, then what follows.</h2>
        <p><code>state</code> declares a reactive value. <code>derive</code> declares a value computed from it. Updating the count updates its doubled value through Niral's fine-grained runtime. Optional annotations check the values before JavaScript is emitted.</p>
        <figure class="code-example">
          <figcaption><span>counter.niral</span><span>Typed reactive state</span></figcaption>
          <pre tabindex="0" aria-label="NiralScript counter example"><code>{example}</code></pre>
        </figure>
        <p class="example-note">Scripts can live inside a <code>.niral</code> component or a separate <code>.nrs</code> file, with named imports from other <code>.nrs</code> modules. NiralScript remains experimental; these results do not establish a stable language release.</p>
        <a class="text-link" href="/docs/reactivity">Explore Niral reactivity <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/arrow-up-right.svg" alt="" width="18" height="18" /></a>
      </div>
    </section>

    <section class="editorial" aria-labelledby="status-title">
      <p class="section-label"><span>03</span> IMPLEMENTED & TESTED</p>
      <div class="section-content">
        <h2 id="status-title">Seven milestones.<br />One independent language.</h2>
        <div class="milestones">
          <div><h3>01 / Semantic safeguards</h3><p>Lexical scopes, unresolved-name diagnostics, initialization checks, readonly inputs and derived-effect safeguards. Named modules retain isolated scopes and original error locations.</p></div>
          <div><h3>02 / Inputs & server data</h3><p>Typed inputs connect route and loader data to components. SSR and hydration preserve instance state; server code remains on the server.</p></div>
          <div><h3>03 / Collections & callbacks</h3><p>Arrow functions, nested binding defaults and rest, default/rest parameters, call spread and typed callbacks work with the shared semantic pipeline. For-of, conventional for and while loops support break and continue.</p></div>
          <div><h3>04 / Async & errors</h3><p>Async functions and arrows, await, throw and try/catch/finally preserve return, rejection and cleanup behavior. Async RPC flows are tested in dev and production builds.</p></div>
          <div><h3>05 / Standalone compilation</h3><p>A checking API and check/compile CLI emit independent ES modules, bundle named module graphs and produce source maps with original sources and imported error locations.</p></div>
          <div><h3>06 / Gradual types</h3><p>Literal types, reusable aliases, type-only imports, function signatures and generic functions extend primitive, union, record and Promise contracts. Branch narrowing and opt-in strict unknown/null checks retain the gradual default.</p></div>
          <div><h3>07 / Classes & constructors</h3><p>Native classes support typed constructors, generic inheritance, private members, accessors, static blocks and instanceof. Methods integrate with reactive state, module imports and original-source diagnostics; class fields remain ordinary JavaScript properties.</p></div>
        </div>
        <p>Existing JavaScript, TypeScript and JSX/TSX support in Niral stays intact. NiralScript is an additional language direction, not a replacement for those workflows.</p>
      </div>
    </section>

    <section class="editorial" aria-labelledby="types-title">
      <p class="section-label"><span>04</span> TYPED COLLECTIONS</p>
      <div class="section-content">
        <h2 id="types-title">Catch the wrong value.<br />Before it reaches the array.</h2>
        <p>Statically named <code>push</code>, <code>unshift</code>, <code>splice</code> and <code>fill</code> calls now check every inserted value against a known array element type. Position arguments and required argument counts are checked too.</p>
        <figure class="code-example">
          <figcaption><span>collections.nrs</span><span>Gradual type checking</span></figcaption>
          <pre tabindex="0" aria-label="Typed array mutation example"><code>{typedExample}</code></pre>
        </figure>
        <p>Simple aliases, typed record fields, annotated parameters and returns, and literal bracket method names retain these checks. Unannotated arrays remain dynamic. Unknown host values remain permissive.</p>
        <p class="example-note">Verified locally on 26 October 2026: all 66 language tests and 258 framework tests pass, including real TypeScript checking. Classes execute in standalone and both component emitters, with inline/external dev/production HTTP, SSR, RPC privacy and original-source exception checks. Nine actual VS Code host check groups pass. Browser tests were not rerun for these changes; the hosted benchmark below predates them.</p>
      </div>
    </section>

    <section class="editorial" aria-labelledby="standalone-title">
      <p class="section-label"><span>05</span> BEYOND COMPONENTS</p>
      <div class="section-content">
        <h2 id="standalone-title">A .nrs file.<br />An ordinary JavaScript module.</h2>
        <p>The standalone compiler does not need a Niral application. Its generated ES module exposes <code>createInstance</code>, with isolated inputs and state, value accessors and input updates. A small included reactive runtime caches derived values; hosts can supply their own compatible runtime.</p>
        <figure class="code-example">
          <figcaption><span>counter.nrs</span><span>Standalone source</span></figcaption>
          <pre tabindex="0" aria-label="Standalone NiralScript source"><code>{standaloneExample}</code></pre>
        </figure>
        <p>Type annotations are erased. Version 3 source maps retain original module sources. The CLI checks import boundaries and refuses to overwrite existing output files.</p>
        <h3>Explicit runtime contracts</h3>
        <p><code>contract&lt;Type&gt;(value)</code> generates runtime checks from the same type declaration. Valid data is copied and returned with that type. Invalid data throws NRS081 with a field path, without coercion.</p>
        <figure class="code-example">
          <figcaption><span>orders.nrs</span><span>Checked data boundary</span></figcaption>
          <pre tabindex="0" aria-label="Runtime contract example"><code>{contractExample}</code></pre>
        </figure>
        <p>Finite numbers, strings, booleans, literals, null, undefined, arrays, records, unions and concrete aliases are supported. Extra record fields and accessor-backed record fields or array elements are rejected. Extra non-index array properties are dropped. Unknown, class, function and promise schemas are compile errors. Ordinary annotations still do not validate external data.</p>
        <p class="example-note">Validation runs only at the explicit expression. Put a server-side guard before business logic; a client check cannot secure an RPC. Niral returns HTTP 400 with field errors for server contract failures. Contracts do not add integer ranges, business rules or automatic input-update validation.</p>
      </div>
    </section>

    <section class="editorial" aria-labelledby="comparison-title">
      <p class="section-label"><span>06</span> JS / TS / NRS</p>
      <div class="section-content">
        <h2 id="comparison-title">Comparable execution.<br />Measured, not assumed.</h2>
        <p>GitHub Actions ran identical function bodies in JavaScript, TypeScript and NiralScript across four workloads. All correctness checks passed. These are direct language tests, without components or reactive operations.</p>
        <div class="results-scroll" role="region" aria-label="Language benchmark results" tabindex="0">
          <table>
            <caption>Microseconds per complete function call. Median of three process medians.</caption>
            <thead><tr><th scope="col">Runner / workload</th><th scope="col">JS</th><th scope="col">TS</th><th scope="col">NRS</th></tr></thead>
            <tbody>
              <tr><th scope="row">Node 22 / 10,000 numbers</th><td>9.436</td><td>9.442</td><td>9.430</td></tr>
              <tr><th scope="row">Node 22 / 1,000 records</th><td>1.310</td><td>1.303</td><td>1.313</td></tr>
              <tr><th scope="row">Node 22 / 1,000 strings</th><td>37.066</td><td>37.346</td><td>37.632</td></tr>
              <tr><th scope="row">Node 22 / 100 awaits</th><td>7.186</td><td>6.708</td><td>6.646</td></tr>
              <tr><th scope="row">Node 24 / 10,000 numbers</th><td>7.476</td><td>7.469</td><td>7.420</td></tr>
              <tr><th scope="row">Node 24 / 1,000 records</th><td>1.165</td><td>1.235</td><td>1.154</td></tr>
              <tr><th scope="row">Node 24 / 1,000 strings</th><td>35.306</td><td>35.336</td><td>35.523</td></tr>
              <tr><th scope="row">Node 24 / 100 awaits</th><td>5.716</td><td>5.779</td><td>5.768</td></tr>
            </tbody>
          </table>
        </div>
        <p class="example-note">Ubuntu 24.04 x64, TypeScript 5.7.3, 30 warmups and 12 rotated rounds per process. Compilation, module loading and instance setup are excluded from execution timings. NiralScript and TypeScript both emit JavaScript running on the same V8 engine.</p>
        <p class="example-note">The Node 22 runner used AMD EPYC 7763; Node 24 used AMD EPYC 9V74. Compare languages within each runner, not Node versions. These four workloads establish neither a universal speed winner nor complete TypeScript type-system or tooling parity.</p>
        <a class="text-link" href="https://github.com/Zyora-Dev/niral/actions/runs/40311729249">View the verified GitHub Actions run</a>
        <p class="example-note">Tested commit: <code>59d721b</code>. All six hosted jobs passed: Node 22/24 language comparisons and Linux/Windows release checks. Hosted results predate the typed-array follow-up.</p>
      </div>
    </section>

    <section class="editorial closing" aria-labelledby="limits-title">
      <p class="section-label"><span>07</span> CURRENT BOUNDARIES</p>
      <div class="section-content">
        <h2 id="limits-title">The limits are explicit.</h2>
        <p>Gradual annotations are not runtime validation; only explicit contract expressions generate guards. Contracts require trusted standard intrinsics and an unshadowed globalThis. Schemas are limited to 64 levels and 1024 type nodes, with 10000 validator visits per call. These limits do not sandbox proxies or impose a hard memory quota. Strict static checking is opt-in through the standalone CLI's --strict flag or the editor's niral.niralscriptStrictTypes setting. Interfaces, casts, generic arrows, constrained type parameters and recursive aliases remain unsupported. Decorators are limited to class declarations, methods, accessors and static fields, and a decorator that replaces its target is not type-checked. Classes do not yet include class expressions, arbitrary computed names, new.target or TypeScript modifiers. Dynamic or detached methods and escaping aliases remain outside the complete static-checking guarantees.</p>
        <p>The Niral VS Code extension now has dedicated .nrs highlighting, compiler diagnostics, declared-type hover, keyword and top-level completions, and local or imported definitions. These additions are in the source version; an updated extension has not been published. Incomplete code receives keyword completions; symbol navigation requires valid source.</p>
        <p>Compile watch mode and additional framework adapters remain future work. The language is experimental, and the measured runtime results are not a claim of complete JavaScript or TypeScript compatibility.</p>
        <div class="links"><a class="text-link" href="/about">About ZyoraLabs</a><a class="text-link" href="/contact">Talk to us about NiralScript</a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</div>

<style>
  :global(body) { margin: 0; background: #090909; color: #fafafa; }
  *, *::before, *::after { box-sizing: border-box; }
  .language-page { --gold: #f2b544; font: 15px/1.8 "Geist", sans-serif; letter-spacing: 0; background: linear-gradient(120deg, #202023, #0d0d0f 65%, #090909); }
  .frame { width: min(1160px, calc(100% - 80px)); margin-inline: auto; }
  h1, h2, h3, p, dl, figure { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--gold); }
  a:focus-visible, pre:focus-visible, .results-scroll:focus-visible { outline: 2px solid var(--gold); outline-offset: 5px; }
  .skip-link { position: absolute; top: -60px; left: 16px; z-index: 50; background: var(--gold); color: #090909; padding: 10px 16px; }
  .skip-link:focus { top: 12px; }
  .introduction { padding-top: 56px; }
  .eyebrow, .section-label, dt, figcaption { font: 12px/1.6 "Geist Mono", monospace; }
  .eyebrow { color: var(--gold); margin-bottom: 20px; }
  h1 { font-size: 64px; line-height: 1.1; font-weight: 550; margin-bottom: 24px; overflow-wrap: anywhere; }
  h1 span { color: var(--gold); }
  .lead { font-size: 26px; line-height: 1.5; }
  .opening { max-width: 750px; margin-top: 20px; font-size: 16px; }
  .identity { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding-block: 28px; border-top: 1px solid #414144; margin-top: 36px; }
  dt { margin-bottom: 8px; }
  dd { margin: 0; font-size: 18px; }
  .editorial { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 60px; border-top: 1px solid #414144; padding-block: 56px; }
  .section-label { display: flex; gap: 20px; padding-top: 8px; }
  .section-label > span { color: var(--gold); }
  .section-content { min-width: 0; }
  h2 { font-size: 34px; line-height: 1.3; font-weight: 500; margin-bottom: 24px; }
  .section-content > p + p { margin-top: 20px; }
  code { font: 13px/1.8 "Geist Mono", monospace; color: var(--gold); }
  .code-example { margin-block: 28px; border: 1px solid #555558; border-radius: 6px; overflow: hidden; background: #111113; }
  figcaption { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid #414144; }
  figcaption span:last-child { color: #a7e8c1; }
  pre { margin: 0; padding: 24px; overflow: auto; tab-size: 2; }
  pre code { color: #fafafa; }
  .example-note { font-size: 14px; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: 20px; text-decoration: underline; text-underline-offset: 6px; }
  .text-link img { filter: invert(1); flex-shrink: 0; }
  .milestones { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-bottom: 28px; }
  .milestones > div { border-top: 2px solid var(--gold); padding-top: 20px; }
  h3 { font-size: 16px; font-weight: 550; margin-bottom: 12px; }
  .milestones p { font-size: 14px; }
  .results-scroll { max-width: 100%; overflow-x: auto; margin-block: 28px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-size: 14px; padding-bottom: 16px; }
  th, td { padding: 14px 10px; border-bottom: 1px solid #414144; text-align: right; }
  thead th { color: var(--gold); font-weight: 500; }
  th:first-child { text-align: left; }
  tbody th { font-weight: 400; }
  .links { display: flex; flex-wrap: wrap; gap: 24px; }
  .closing { padding-bottom: 80px; }
  @media (max-width: 1000px) { .editorial { grid-template-columns: 160px minmax(0, 1fr); gap: 32px; } .milestones { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .frame { width: calc(100% - 40px); }
    .introduction { padding-top: 36px; }
    h1 { font-size: 42px; }
    .lead { font-size: 21px; }
    .opening { font-size: 15px; }
    .identity { gap: 16px; margin-top: 28px; }
    dd { font-size: 15px; }
    .editorial { grid-template-columns: 1fr; gap: 24px; padding-block: 36px; }
    .section-label { padding: 0; }
    h2 { font-size: 28px; }
    pre { padding: 18px; }
    .closing { padding-bottom: 56px; }
  }
  @media (max-width: 420px) { .identity { grid-template-columns: 1fr 1fr; } .identity > div:last-child { grid-column: 1 / -1; } dt { margin-bottom: 2px; } }
</style>
