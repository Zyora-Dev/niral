  }
  @media (prefers-reduced-motion: no-preference) {
    .intro .eyebrow, h1, .intro-line, .intro-description { animation: arrive .5s ease-out both; }
    .intro-line { animation-delay: .08s; }
    .intro-description { animation-delay: .16s; }
    @keyframes arrive { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  }
</style>