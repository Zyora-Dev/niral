<script>
  const icons = "https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/"
  const examples = {
    counter: 'state count: number = 2\nderive doubled: number = count * 2\n\nexport function main(): number {\n  count += 1\n  print("Count:", count)\n  return doubled\n}',
    collections: 'const items: number[] = [1, 2, 3]\n\nexport function main() {\n  items.push(4)\n  const doubled = items.map(value => value * 2)\n  print("Doubled:", doubled)\n  return items.reduce((total, value) => total + value, 0)\n}',
    async: 'async function double(value: number): Promise<number> {\n  return value * 2\n}\n\nexport async function main(): Promise<number> {\n  const result = await double(21)\n  print("Resolved:", result)\n  return result\n}',
    types: 'state items: number[] = [1, 2]\n\nitems.push("wrong")\n\nexport function main() {\n  return items\n}'
  }
  let selected = $state("counter")
  let source = $state(examples.counter)
  let output = $state("")
  let code = $state("")
  let status = $state("Ready")
  let busy = $state(false)
  let ready = $state(false)
  let tab = $state("output")
  let runner
  let alive = true
  onMount(() => {
    import("/lib/playground.js").then(({ createPlayground }) => {
      if (!alive) return
      runner = createPlayground(result => {
        if (result.output !== undefined) output = result.output
        if (result.code !== undefined) code = result.code
        if (result.status !== undefined) status = result.status
        if (result.busy !== undefined) busy = result.busy
      })
      ready = true
    }).catch(() => {
      if (!alive) return
      status = "Error"
      output = "Playground failed to load. Reload and try again."
    })
  })
  onDestroy(() => { alive = false; runner?.stop() })
  function run() { if (ready && !busy) runner.run(source) }
  function stop() { runner?.stop(); busy = false; status = "Stopped" }
  function reset() {
    runner?.stop()
    busy = false
    source = examples[selected]
    output = ""
    code = ""
    status = "Ready"
  }
  function sourceKey(event) {
    if ((event.ctrlKey || event.metaKey) && event.key === "Enter") { event.preventDefault(); run() }
  }
  function tabKey(event) {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return
    event.preventDefault()
    tab = event.key === "Home" ? "output" : event.key === "End" ? "code" : tab === "output" ? "code" : "output"
    event.currentTarget.parentElement.querySelector(tab === "output" ? "#playground-output-tab" : "#playground-code-tab").focus()
  }
</script>

<section id="playground" class="playground" aria-labelledby="playground-title">
  <header class="heading"><h2 id="playground-title">Playground<span>.nrs</span></h2><span class="status" class:error={status === "Error"} role="status">{status}</span></header>
  <div class="workbench">
    <div class="toolbar">
      <label for="playground-example">Example</label>
      <select id="playground-example" bind:value={selected} on:change={reset}>
        <option value="counter">Reactive counter</option>
        <option value="collections">Collections</option>
        <option value="async">Async functions</option>
        <option value="types">Type checking</option>
      </select>
      <div class="actions">
        <button class="icon-button" type="button" on:click={reset} title="Reset example" aria-label="Reset example"><img src={icons + "rotate-ccw.svg"} alt="" width="18" height="18" /></button>
        <button class="icon-button" type="button" on:click={stop} disabled={!busy} title="Stop execution" aria-label="Stop execution"><img src={icons + "square.svg"} alt="" width="16" height="16" /></button>
        <button class="run" type="button" on:click={run} disabled={!ready || busy} title="Run source (Ctrl or Command + Enter)"><img src={icons + "play.svg"} alt="" width="17" height="17" />Run</button>
      </div>
    </div>
    <div class="panes">
      <div class="source-pane">
        <label class="pane-label" for="playground-source">playground.nrs</label>
        <textarea id="playground-source" aria-label="NiralScript source" spellcheck="false" autocapitalize="off" autocomplete="off" maxlength="50000" bind:value={source} on:keydown={sourceKey}></textarea>
      </div>
      <div class="result-pane">
        <div class="tabs" role="tablist" aria-label="Playground results">
          <button id="playground-output-tab" role="tab" type="button" aria-controls="playground-output" aria-selected={tab === "output" ? "true" : "false"} tabindex={tab === "output" ? 0 : -1} on:click={() => tab = "output"} on:keydown={tabKey}>Output</button>
          <button id="playground-code-tab" role="tab" type="button" aria-controls="playground-code" aria-selected={tab === "code" ? "true" : "false"} tabindex={tab === "code" ? 0 : -1} on:click={() => tab = "code"} on:keydown={tabKey}>JavaScript</button>
        </div>
        <pre id="playground-output" role="tabpanel" aria-labelledby="playground-output-tab" tabindex="0" hidden={tab !== "output"}>{output}</pre>
        <pre id="playground-code" role="tabpanel" aria-labelledby="playground-code-tab" tabindex="0" hidden={tab !== "code"}>{code}</pre>
      </div>
    </div>
    <footer><span>Browser-local / single file</span><span>2 s execution limit</span></footer>
  </div>
  <noscript>JavaScript is required for the NiralScript playground.</noscript>
</section>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  .playground { padding-block: 44px 56px; border-top: 1px solid #414144; letter-spacing: 0; scroll-margin-top: 90px; }
  .heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 24px; }
  h2 { margin: 0; font: 500 28px/1.3 "Geist", sans-serif; color: #fafafa; }
  h2 span { margin-left: 10px; color: #a7e8c1; font: 16px "Geist Mono", monospace; }
  .status { font: 13px "Geist Mono", monospace; color: #a7e8c1; }
  .status.error { color: #ffb2ac; }
  .workbench { border: 1px solid #555558; border-radius: 6px; overflow: hidden; background: #111113; }
  .toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; min-height: 66px; padding: 12px 16px; border-bottom: 1px solid #414144; }
  .toolbar label { font-size: 13px; color: #fafafa; }
  select, button { color: #fafafa; font: 13px "Geist", sans-serif; }
  select { background: #232326; border: 1px solid #66666b; border-radius: 4px; min-height: 38px; padding: 6px 10px; max-width: 100%; }
  .actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  button { cursor: pointer; border: 1px solid #555558; background: transparent; border-radius: 4px; }
  button:hover:not(:disabled) { background: #343437; }
  button:disabled { cursor: default; opacity: .5; }
  .icon-button { display: grid; place-items: center; width: 38px; height: 38px; padding: 0; }
  .icon-button img { filter: invert(1); }
  .run { display: flex; align-items: center; justify-content: center; gap: 9px; min-width: 82px; height: 38px; padding: 0 14px; background: #f2b544; border-color: #f2b544; color: #101010; font-weight: 600; }
  .run:hover:not(:disabled) { background: #ffd079; }
  .panes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .source-pane { min-width: 0; border-right: 1px solid #414144; }
  .result-pane { min-width: 0; background: #171719; }
  .pane-label, .tabs { display: flex; align-items: center; height: 46px; border-bottom: 1px solid #414144; font: 12px "Geist Mono", monospace; }
  .pane-label { padding-inline: 20px; color: #fafafa; }
  .tabs { gap: 4px; padding-inline: 12px; }
  .tabs button { height: 46px; padding: 0 12px; border: 0; border-radius: 0; border-bottom: 2px solid transparent; }
  .tabs button[aria-selected="true"] { color: #f2b544; border-bottom-color: #f2b544; }
  textarea, pre { display: block; width: 100%; height: 330px; margin: 0; padding: 20px; border: 0; background: transparent; color: #fafafa; font: 13px/1.8 "Geist Mono", monospace; tab-size: 2; overflow: auto; }
  textarea { resize: none; border-radius: 0; white-space: pre; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  pre[hidden] { display: none; }
  button:focus-visible, select:focus-visible, textarea:focus-visible, pre:focus-visible { outline: 2px solid #f2b544; outline-offset: -3px; }
  footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 20px; border-top: 1px solid #414144; color: #fafafa; font: 12px/1.6 "Geist Mono", monospace; }
  @media (max-width: 760px) {
    .playground { padding-block: 32px 36px; }
    h2 { font-size: 24px; }
    .panes { grid-template-columns: minmax(0, 1fr); }
    .source-pane { border-right: 0; border-bottom: 1px solid #414144; }
    textarea { height: 300px; padding: 16px; font-size: 14px; }
    pre { height: 230px; padding: 16px; }
    .toolbar { gap: 10px; padding: 12px; }
    .toolbar label { display: none; }
    select { flex: 1; min-width: 0; width: 140px; }
    .actions { gap: 5px; }
    .run { min-width: 64px; padding: 0 8px; }
    .icon-button { width: 34px; }
    footer { padding-inline: 16px; }
  }
</style>