{
  "name": "niral-vscode",
  "displayName": "Niral",
  "description": "Language support for Niral and NiralScript: highlighting, diagnostics, completions, hover and .nrs definitions.",
  "icon": "icon.png",
  "version": "0.1.1",
  "publisher": "zyoralabs",
  "license": "MIT",
  "homepage": "https://niral.site",
  "repository": { "type": "git", "url": "https://github.com/Zyora-Dev/niral.git", "directory": "editors/vscode" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "niral",
        "aliases": ["Niral", "niral"],
        "extensions": [".niral"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "niralscript",
        "aliases": ["NiralScript", "niralscript"],
        "extensions": [".nrs"],
        "configuration": "./niralscript-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "niralscript",
        "scopeName": "source.niralscript",
        "path": "./syntaxes/niralscript.tmLanguage.json"
      },
      {
        "language": "niral",
        "scopeName": "source.niral",
        "path": "./syntaxes/niral.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.css": "css",
          "meta.embedded.expression.javascript": "javascript"
        }
      }
    ],
    "configuration": {
      "title": "Niral",
      "properties": {
        "niral.niralscriptStrictTypes": {
          "type": "boolean",
          "default": false,
          "description": "Require narrowing unknown and nullable values in standalone .nrs checking. Reload the window after changes."
        },
        "niral.niralscriptGlobals": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Explicit host globals for standalone .nrs checking (same contract as nrs --global). Reload the window after changes."
        },
        "niral.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the niral CLI (bin/niral.js). Leave empty to auto-detect from node_modules or a sibling checkout."
        }
      }
    }
  }
}
